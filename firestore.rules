rules_version = '2';

// Admins: a doc at /admins/{uid} (created by hand in the Firebase console).
// Visitors: anonymous Auth sessions.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function isAdmin() {
      return logado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow write: if false;
    }

    match /estandes/{estandeId} {
      // Nonexistent doc is readable so the app can tell "invalid QR" (not found)
      // apart from "inactive stand" (permission denied).
      allow get: if isAdmin() || (logado() && (resource == null || resource.data.ativo == true));
      allow list: if isAdmin() || (logado() && resource.data.ativo == true);
      allow write: if isAdmin();
    }

    match /checkins/{checkinId} {
      // Visitors may list only their own check-ins ("visited" badges and progress).
      allow list: if isAdmin() || (logado() && resource.data.visitanteId == request.auth.uid);
      // A visitor may look up only their own check-in keys (duplicate check).
      allow get: if isAdmin() || (logado() && checkinId.matches(request.auth.uid + '_.+'));
      allow create: if logado()
        && checkinId == request.auth.uid + '_' + request.resource.data.estandeId
        && request.resource.data.visitanteId == request.auth.uid
        && request.resource.data.keys().hasOnly(['visitanteId', 'estandeId', 'criadoEm'])
        && request.resource.data.criadoEm == request.time
        && get(/databases/$(database)/documents/estandes/$(request.resource.data.estandeId)).data.ativo == true;
      // Check-ins are immutable; overwriting an existing key is an update and is denied.
      allow update, delete: if false;
    }
  }
}
